		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>slash-maven-virtual-snapshots</name>
			<url>https://soleng.jfrog.io/artifactory/slash-maven-virtual</url>
		</snapshotRepository>
	</distributionManagement> -->

</project>
